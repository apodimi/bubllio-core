{
  "name": "@bubllio/core-api",
  "version": "0.0.0",
  "private": true,
  "description": "Bubllio Core control-plane API",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "npm run prisma:generate && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "6.2.13",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "typescript": "6.0.2",
    "vitest": "5.0.5"
  }
}
