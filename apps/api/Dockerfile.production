FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS dependencies

WORKDIR /app
COPY apps/api/package.json apps/api/package-lock.json ./
RUN npm ci

FROM dependencies AS build

COPY apps/api/nest-cli.json apps/api/prisma.config.ts apps/api/tsconfig.json ./
COPY apps/api/prisma ./prisma
COPY apps/api/src ./src
RUN npm run build

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runtime-dependencies

ENV NODE_ENV=production
WORKDIR /app
COPY apps/api/package.json apps/api/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runtime

ENV NODE_ENV=production
WORKDIR /app
COPY --from=runtime-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --chown=node:node deploy/runtime/core-entrypoint.mjs ./bin/core-entrypoint.mjs
USER node
EXPOSE 3100
ENTRYPOINT ["node", "/app/bin/core-entrypoint.mjs"]
CMD ["api"]

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS migration

ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node apps/api/package.json apps/api/package-lock.json apps/api/prisma.config.ts ./
COPY --chown=node:node apps/api/prisma ./prisma
COPY --chown=node:node deploy/runtime/core-entrypoint.mjs ./bin/core-entrypoint.mjs
USER node
ENTRYPOINT ["node", "/app/bin/core-entrypoint.mjs"]
CMD ["migrate"]
