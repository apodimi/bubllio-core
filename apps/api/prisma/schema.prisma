generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  NEEDS_ATTENTION
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InstallationSetupStatus {
  NOT_STARTED
  CLAIMED
  PROVISIONING
  READY
  NEEDS_ATTENTION
}

enum ProvisioningOperationType {
  CREATE_ORGANIZATION
  ADD_MEMBER
  REMOVE_MEMBER
}

enum ProvisioningOperationStatus {
  PENDING
  PROCESSING
  AWAITING_OWNER
  SUCCEEDED
  FAILED
}

model Organization {
  id                     String                       @id @default(uuid()) @db.Uuid
  slug                   String                       @unique @db.VarChar(63)
  displayName            String                       @map("display_name") @db.VarChar(120)
  keycloakOrganizationId String?                      @unique @map("keycloak_organization_id") @db.Uuid
  status                 OrganizationStatus           @default(PROVISIONING)
  version                Int                          @default(1)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditEvents            AuditEvent[]
  installationSetup      InstallationSetup?
  provisioningOperations ProvisioningOperation[]
  roleAssignments        OrganizationRoleAssignment[]
  applications           OrganizationApplication[]

  @@map("organizations")
}

model InstallationSetup {
  id                  Int                     @id @default(1)
  status              InstallationSetupStatus @default(NOT_STARTED)
  claimedBySubject    String?                 @map("claimed_by_subject") @db.VarChar(255)
  claimIdempotencyKey String?                 @map("claim_idempotency_key") @db.VarChar(255)
  organizationId      String?                 @unique @map("organization_id") @db.Uuid
  claimedAt           DateTime?               @map("claimed_at") @db.Timestamptz(3)
  claimExpiresAt      DateTime?               @map("claim_expires_at") @db.Timestamptz(3)
  completedAt         DateTime?               @map("completed_at") @db.Timestamptz(3)
  version             Int                     @default(1)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("installation_setup")
}

model OrganizationRoleAssignment {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  subject           String                   @db.VarChar(255)
  role              OrganizationRole
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationGrants MemberApplicationGrant[]

  @@unique([organizationId, subject])
  @@index([subject])
  @@map("organization_role_assignments")
}

model Application {
  key                      String                    @id @db.VarChar(63)
  displayName              String                    @map("display_name") @db.VarChar(80)
  launchUrl                String                    @map("launch_url") @db.VarChar(2048)
  audience                 String                    @db.VarChar(255)
  contractVersion          String                    @default("1") @map("contract_version") @db.VarChar(32)
  available                Boolean                   @default(true)
  managedByManifest        Boolean                   @default(false) @map("managed_by_manifest")
  installedAt              DateTime                  @default(now()) @map("installed_at") @db.Timestamptz(3)
  organizationApplications OrganizationApplication[]

  @@map("applications")
}

model OrganizationApplication {
  organizationId String                   @map("organization_id") @db.Uuid
  applicationKey String                   @map("application_key") @db.VarChar(63)
  enabled        Boolean                  @default(true)
  entitled       Boolean                  @default(true)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application              @relation(fields: [applicationKey], references: [key], onDelete: Restrict)
  memberGrants   MemberApplicationGrant[]

  @@id([organizationId, applicationKey])
  @@map("organization_applications")
}

model MemberApplicationGrant {
  organizationId  String                     @map("organization_id") @db.Uuid
  applicationKey  String                     @map("application_key") @db.VarChar(63)
  subject         String                     @db.VarChar(255)
  active          Boolean                    @default(true)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizationApp OrganizationApplication    @relation(fields: [organizationId, applicationKey], references: [organizationId, applicationKey], onDelete: Cascade)
  member          OrganizationRoleAssignment @relation(fields: [organizationId, subject], references: [organizationId, subject], onDelete: Cascade)

  @@id([organizationId, applicationKey, subject])
  @@index([subject])
  @@map("member_application_grants")
}

model ProvisioningOperation {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  actorSubject   String                      @map("actor_subject") @db.VarChar(255)
  type           ProvisioningOperationType
  status         ProvisioningOperationStatus @default(PENDING)
  idempotencyKey String                      @map("idempotency_key") @db.VarChar(255)
  requestHash    String                      @map("request_hash") @db.Char(64)
  attemptCount   Int                         @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?                   @map("next_attempt_at") @db.Timestamptz(3)
  errorCode      String?                     @map("error_code") @db.VarChar(100)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([actorSubject, organizationId, type, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@map("provisioning_operations")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorSubject   String       @map("actor_subject") @db.VarChar(255)
  targetType     String       @map("target_type") @db.VarChar(100)
  targetId       String       @map("target_id") @db.VarChar(255)
  action         String       @db.VarChar(100)
  outcome        String       @db.VarChar(50)
  correlationId  String       @map("correlation_id") @db.VarChar(255)
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(255)
  beforeState    Json?        @map("before_state")
  afterState     Json?        @map("after_state")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}
