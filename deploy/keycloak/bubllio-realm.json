{
  "realm": "bubllio",
  "enabled": true,
  "displayName": "Bubllio",
  "loginTheme": "bubllio",
  "emailTheme": "bubllio",
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "el"],
  "defaultLocale": "en",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "actionTokenGeneratedByUserLifespan": 900,
  "rememberMe": true,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "AUTH_TIME",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "organization",
      "description": "Bubllio organization membership claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "addOrganizationAttributes": "false",
            "id.token.claim": "true",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "addOrganizationDomain": "false",
            "claim.name": "organization",
            "jsonType.label": "JSON",
            "addOrganizationId": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "bubllio-core-api",
      "name": "Bubllio Core API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "bubllio-core-web",
      "name": "Bubllio Core Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "profile", "email", "organization"],
      "redirectUris": ["${CORE_WEB_URL}/*"],
      "webOrigins": ["${CORE_WEB_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${CORE_WEB_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "core-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bubllio-core-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bubllio-core-runtime",
      "name": "Bubllio Core runtime",
      "enabled": true,
      "publicClient": false,
      "secret": "${CORE_KEYCLOAK_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "bubllio-identity-bootstrap",
      "name": "Bubllio identity bootstrap",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_BOOTSTRAP_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-bubllio-core-runtime",
      "enabled": true,
      "serviceAccountClientId": "bubllio-core-runtime",
      "clientRoles": {
        "realm-management": [
          "query-organizations",
          "view-organizations",
          "manage-organizations",
          "view-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "service-account-bubllio-identity-bootstrap",
      "enabled": true,
      "serviceAccountClientId": "bubllio-identity-bootstrap",
      "clientRoles": {
        "realm-management": [
          "manage-realm",
          "manage-clients"
        ]
      }
    }
  ]
}
