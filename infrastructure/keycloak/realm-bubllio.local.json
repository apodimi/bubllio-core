{
  "realm": "bubllio",
  "enabled": true,
  "displayName": "Bubllio",
  "loginTheme": "bubllio",
  "emailTheme": "bubllio",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "el"],
  "defaultLocale": "en",
  "organizationsEnabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "actionTokenGeneratedByUserLifespan": 900,
  "rememberMe": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "identity@bubllio.test",
    "fromDisplayName": "Bubllio Identity",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clientScopes": [
    {
      "name": "organization",
      "description": "Additional claims about the organization a subject belongs to",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "consent.screen.text": "${organizationScopeConsentText}",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "addOrganizationAttributes": "false",
            "id.token.claim": "true",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "addOrganizationDomain": "false",
            "claim.name": "organization",
            "jsonType.label": "JSON",
            "addOrganizationId": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "bubllio-core-api",
      "name": "Bubllio Core API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "bubllio-core-web",
      "name": "Bubllio Core Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://127.0.0.1:5174/*"],
      "webOrigins": ["http://127.0.0.1:5174"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5174/*"
      },
      "protocolMappers": [
        {
          "name": "core-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bubllio-core-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bubllio-crm-web",
      "name": "Bubllio CRM Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://127.0.0.1:5173/*"],
      "webOrigins": ["http://127.0.0.1:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/*"
      }
    },
    {
      "clientId": "bubllio-board-web",
      "name": "Bubllio Board Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://127.0.0.1:5175/*"],
      "webOrigins": ["http://127.0.0.1:5175"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5175/*"
      }
    }
  ],
  "users": [
    {
      "username": "spike-user",
      "email": "spike-user@example.test",
      "firstName": "Spike",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local-spike-password",
          "temporary": false
        }
      ]
    }
  ]
}
