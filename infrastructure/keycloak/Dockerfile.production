FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS theme-build

WORKDIR /theme
RUN apk add --no-cache maven
COPY apps/keycloak-theme/package.json apps/keycloak-theme/package-lock.json ./
RUN npm ci
COPY apps/keycloak-theme ./
RUN npm run build:keycloak

FROM quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244 AS keycloak-build

ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true
COPY --from=theme-build --chown=keycloak:keycloak \
    /theme/dist_keycloak/keycloak-theme-for-kc-all-other-versions.jar \
    /opt/keycloak/providers/bubllio-theme.jar
RUN touch -m --date=@1761264000 /opt/keycloak/providers/bubllio-theme.jar && \
    /opt/keycloak/bin/kc.sh build --vault=file

FROM quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244 AS runtime

ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_VAULT=file \
    KC_VAULT_DIR=/opt/keycloak/vault
COPY --from=keycloak-build --chown=keycloak:keycloak /opt/keycloak/ /opt/keycloak/
COPY --chown=keycloak:keycloak --chmod=755 deploy/runtime/keycloak-entrypoint.sh /opt/keycloak/bin/bubllio-entrypoint.sh
COPY --chown=keycloak:keycloak --chmod=444 deploy/keycloak/bubllio-realm.json /opt/keycloak/data/import/bubllio-realm.json
# COPY can apply its file mode to a newly created parent directory as well.
# Preserve read-only realm data while allowing the non-root importer to traverse.
RUN chmod 0755 /opt/keycloak/data/import && \
    test -r /opt/keycloak/data/import/bubllio-realm.json
USER keycloak
EXPOSE 8080 9000
ENTRYPOINT ["/opt/keycloak/bin/bubllio-entrypoint.sh"]
CMD ["start", "--optimized"]
